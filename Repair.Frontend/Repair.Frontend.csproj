<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Repair</ApplicationTitle>
    <AssemblyName>Repair</AssemblyName>
    <!-- App Identifier -->
    <ApplicationId>com.FangSoftware.Repair</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>André</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Repair powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      CSharpMarkup;
      Material;
      Dsp;
      Hosting;
      Toolkit;
      Logging;
      LoggingSerilog;
      Mvvm;
      Configuration;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Uno.CommunityToolkit.WinUI.UI.Controls.DataGrid" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Repair.Models\Repair.Models.csproj" />
    <ProjectReference Include="..\Repair.Persistence\Repair.Persistence.csproj" />
    <ProjectReference Include="..\Repair.Services\Repair.Services.csproj" />
    <ProjectReference Include="..\Repair.Startup\Repair.Startup.csproj" />
  </ItemGroup>

<ItemGroup>
  <Compile Update="Presentation\**\*.*.cs">
    <DependentUpon>$([System.String]::Copy('%(Filename)').Split('.')[0]).cs</DependentUpon>
  </Compile>
</ItemGroup>

<ItemGroup>
  <Folder Include="Presentation\Pages\" />
</ItemGroup>

<ItemGroup>
    <EmbeddedResource Include="..\README.md">
        <Link>README.md</Link>
        <LogicalName>README.md</LogicalName>
    </EmbeddedResource>
</ItemGroup>

</Project>
